# Copy to .env for local development (pnpm dev). `docker compose up` needs NO .env file.

# --- server ---
PORT=8080
NODE_ENV=development
APP_URL=http://localhost:5173        # public URL of the site (used in emails + payment redirects)
MONGODB_URI=mongodb://127.0.0.1:27017/cart2heavy
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
UPLOAD_DIR=./uploads

# --- shop rules ---
DELIVERY_FEE_CENTS=180               # $1.80
MIN_ORDER_CENTS=2500                 # $25.00 minimum order

# --- payments: "mock" (default, no account needed) or "stripe" ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=                   # sk_test_... ; if set, PAYMENT_PROVIDER defaults to stripe
STRIPE_WEBHOOK_SECRET=               # whsec_... (optional, for the webhook endpoint)

# --- email (Mailpit catches everything on http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="cart2heavy <no-reply@cart2heavy.local>"

# --- demo data ---
SEED_ON_START=false                  # true = fill an EMPTY database with demo data + demo accounts
